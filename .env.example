APP_NAME=eConsent
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=econsent
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Subscription invoice reminders
SUBSCRIPTION_INVOICE_REMINDERS_ENABLED=true
SUBSCRIPTION_INVOICE_MANUAL_RETRY_MINUTES=5

# Resend free-tier quota safety
EMAIL_QUOTA_ENABLED=true
EMAIL_QUOTA_ONLY_MAILER=resend
EMAIL_DAILY_LIMIT=99
EMAIL_DAILY_WINDOW_HOURS=24
EMAIL_MONTHLY_LIMIT=2999
EMAIL_MONTHLY_WINDOW_DAYS=31
EMAIL_CRITICAL_DAILY_RESERVE=5
EMAIL_CRITICAL_MONTHLY_RESERVE=50
EMAIL_PER_SECOND_LIMIT=8
EMAIL_QUOTA_RELEASE_BUFFER_SECONDS=5

# Public organization logos
ORGANIZATION_BRANDING_DISK=public
PLATFORM_BRANDING_DISK=public

# Private immutable consent PDFs
CONSENT_PDF_DISK=local
APP_TIMEZONE=UTC
APP_DISPLAY_TIMEZONE=Africa/Nairobi
