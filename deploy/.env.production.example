APP_NAME="Consent Platform"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://SERVER_IP_OR_DOMAIN

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids

MAIL_MAILER=array
MAIL_FROM_ADDRESS=consent@example.test
MAIL_FROM_NAME="${APP_NAME}"

SECURITY_FORCE_HTTPS=false
SECURITY_ALLOWED_HOSTS=
SECURITY_CSP_MODE=report-only

PRODUCTION_BACKUP_RETENTION_DAYS=14
PRODUCTION_BACKUP_RETENTION_COUNT=14
PRODUCTION_BACKUP_PRIVATE_FILES=true
PRODUCTION_LOG_RETENTION_DAYS=30
PRODUCTION_FAILED_JOB_RETENTION_DAYS=30

# Change after the domain and HTTPS certificate are installed:
#
# APP_URL=https://consent.yourdomain.com
# SESSION_SECURE_COOKIE=true
# SECURITY_FORCE_HTTPS=true
# SECURITY_ALLOWED_HOSTS=consent.yourdomain.com
# SECURITY_CSP_MODE=enforce
#
# Add live SMTP credentials and replace the placeholder
# MAIL_FROM_ADDRESS after domain verification.
