APP_NAME="Consent Platform"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://YOUR_DOMAIN

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=consent_platform
DB_USERNAME=consent_platform
DB_PASSWORD=CHANGE_ME
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=SMTP_HOST
MAIL_PORT=587
MAIL_USERNAME=SMTP_USERNAME
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM_ADDRESS=consent@YOUR_DOMAIN
MAIL_FROM_NAME="${APP_NAME}"

SECURITY_FORCE_HTTPS=true
SECURITY_ALLOWED_HOSTS=YOUR_DOMAIN
SECURITY_CSP_MODE=report-only
SECURITY_HSTS_MAX_AGE=31536000

PRODUCTION_HEARTBEAT_DIRECTORY=production-readiness
PRODUCTION_SCHEDULER_MAX_AGE_SECONDS=180
PRODUCTION_QUEUE_MAX_AGE_SECONDS=180
PRODUCTION_HEARTBEAT_QUEUE=default

PRODUCTION_BACKUP_DIRECTORY=production-backups
PRODUCTION_BACKUP_RETENTION_DAYS=14
PRODUCTION_BACKUP_RETENTION_COUNT=14
PRODUCTION_BACKUP_PRIVATE_FILES=true
PRODUCTION_BACKUP_WARNING_AGE_HOURS=36

PRODUCTION_LOG_RETENTION_DAYS=30
PRODUCTION_FAILED_JOB_RETENTION_DAYS=30
PRODUCTION_MINIMUM_PHP_VERSION=8.3.0
PRODUCTION_MINIMUM_FREE_DISK_MB=1024
PRODUCTION_MAX_QUEUED_JOBS_WARNING=100

SUBSCRIPTION_INVOICE_REMINDERS_ENABLED=true
SUBSCRIPTION_INVOICE_MANUAL_RETRY_MINUTES=5

VITE_APP_NAME="${APP_NAME}"

# Managed PostgreSQL providers commonly require:
# DB_SSLMODE=require
#
# Keep SECURITY_CSP_MODE=report-only for the first live verification.
# Change it to enforce only after reviewing browser CSP reports.
#
# Never commit the completed production .env file.
