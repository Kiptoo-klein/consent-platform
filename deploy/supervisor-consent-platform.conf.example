[program:consent-platform-worker]
process_name=%(program_name)s_%(process_num)02d
command=/usr/bin/php /var/www/consent-platform/artisan queue:work database --queue=emails,default --sleep=3 --tries=3 --backoff=60 --timeout=120 --max-time=3600
directory=/var/www/consent-platform
autostart=true
autorestart=true
stopasgroup=true
killasgroup=true
user=www-data
numprocs=1
redirect_stderr=true
stdout_logfile=/var/www/consent-platform/storage/logs/worker.log
stopwaitsecs=180
